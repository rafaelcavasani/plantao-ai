# Ambiente
ENV=development
LOG_LEVEL=INFO

# Banco de dados (ver docker-compose.yml)
# DATABASE_URL: papel plantao_app (sem superusuario, sujeito a RLS). Usado pela API, worker e scripts.
# DATABASE_ADMIN_URL: dono do banco. Usado so por migracoes (alembic) e seed_tenant.
DATABASE_URL=postgresql+asyncpg://plantao_app:plantao_app@localhost:5432/plantao
DATABASE_ADMIN_URL=postgresql+asyncpg://plantao:plantao@localhost:5432/plantao
APP_DB_PASSWORD=plantao_app
REDIS_URL=redis://localhost:6379/0

# Empresa piloto (id impresso por scripts.seed_tenant)
PILOT_TENANT_ID=

# Modelos de IA via OpenRouter
OPENROUTER_API_KEY=
MODEL_CHEAP=anthropic/claude-3-haiku
MODEL_STRONG=anthropic/claude-3.5-sonnet
EMBEDDING_MODEL=openai/text-embedding-3-small

# Seguranca e PII (gerar uma vez e guardar fora do repositorio)
# PII_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PII_HASH_KEY:       python -c "import secrets; print(secrets.token_urlsafe(48))"
# WHATSAPP_WEBHOOK_SECRET: python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_ENCRYPTION_KEY=
PII_HASH_KEY=
WHATSAPP_WEBHOOK_SECRET=

# Limites e tempos
RATE_LIMIT_MSGS_PER_MIN=60
HANDOFF_TTL_MINUTES=60

# Observabilidade
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=plantao-ai

# WhatsApp (Evolution API self-hosted no MVP)
WHATSAPP_PROVIDER=evolution
WHATSAPP_BASE_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=plantao
WHATSAPP_VERIFY_TOKEN=change-me
