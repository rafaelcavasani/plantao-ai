# Ambiente
ENV=development
LOG_LEVEL=INFO

# Banco de dados (ver docker-compose.yml)
# DATABASE_URL: papel plantao_app (sem superusuario, sujeito a RLS). Usado pela API e pelo worker.
# DATABASE_ADMIN_URL: dono do banco. Usado por migracoes (alembic) e por scripts/tenants.py.
DATABASE_URL=postgresql+asyncpg://plantao_app:plantao_app@localhost:5432/plantao
DATABASE_ADMIN_URL=postgresql+asyncpg://plantao:plantao@localhost:5432/plantao
APP_DB_PASSWORD=plantao_app
REDIS_URL=redis://localhost:6379/0

# Modelos de IA via OpenRouter
OPENROUTER_API_KEY=
MODEL_CHEAP=anthropic/claude-3-haiku
MODEL_STRONG=anthropic/claude-3.5-sonnet
EMBEDDING_MODEL=openai/text-embedding-3-small

# Seguranca e PII (gerar uma vez e guardar fora do repositorio)
# PII_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PII_HASH_KEY:       python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# Exclusao de dados de empresa: tempo de espera antes de apagar, para o worker terminar o que esta em andamento
PURGE_DRENAGEM_SEGUNDOS=120

# Observabilidade
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=plantao-ai

# WhatsApp (Evolution API self-hosted no MVP)
# Dados da instancia e credenciais de cada empresa NAO ficam aqui: o arquivo de onboarding
# (scripts/tenants.py create --arquivo ...) referencia variaveis de ambiente por nome
# (ex.: ACME_EVOLUTION_API_KEY, ACME_WEBHOOK_TOKEN) e o CLI as grava cifradas no banco.
WHATSAPP_PROVIDER=evolution
WHATSAPP_BASE_URL=http://localhost:8080
WHATSAPP_VERIFY_TOKEN=change-me

# Painel de operacao (spec 004)
# DATABASE_PAINEL_URL: papel plantao_painel (so leitura; sem acesso a conteudo de mensagem, contato nem credenciais).
# PAINEL_DB_PASSWORD: senha desse papel, usada pela migracao 0005 (defina um valor proprio em producao).
DATABASE_PAINEL_URL=postgresql+asyncpg://plantao_painel:plantao_painel@localhost:5432/plantao
PAINEL_DB_PASSWORD=plantao_painel
# OPERADORES: quem pode entrar, "email:papel,email:papel" (papel: leitura | operacao). Vazio = ninguem entra.
OPERADORES=
# Login por provedor OIDC (ex.: Google). PAINEL_AUTH_MODE=dev so funciona com ENV=development.
# Desenvolvimento com o Dex local (docker compose up -d oidc; usuarios em infra/dex/config.yaml, senha plantao123):
#   OIDC_ISSUER=http://localhost:5556/dex  OIDC_CLIENT_ID=plantao-painel  OIDC_CLIENT_SECRET=plantao-painel-dev-secret
#   OPERADORES=operador@plantao.local:operacao,leitor@plantao.local:leitura
PAINEL_AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/admin/auth/retorno
PAINEL_SESSAO_INATIVIDADE_MIN=30
PAINEL_SESSAO_MAXIMA_H=12
# Limites do alerta de atencao e de taxa de escrita por operador
PAINEL_LIMITE_SILENCIO_HORAS=24
PAINEL_LIMITE_HANDOFF_PCT=30
PAINEL_LIMITE_CUSTO_PCT=90
PAINEL_ESCRITA_POR_MINUTO=60

